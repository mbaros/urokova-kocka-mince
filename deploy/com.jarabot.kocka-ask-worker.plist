<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent: run the „Zeptej se Mince“ answerer on this Mac (where Claude Code is logged in
     with the Max plan) against the ask queue on martin1 over ssh.
       cp deploy/com.jarabot.kocka-ask-worker.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jarabot.kocka-ask-worker.plist
       tail -f ~/Library/Logs/kocka-ask-worker.log
     Stop:  launchctl bootout gui/$(id -u)/com.jarabot.kocka-ask-worker -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jarabot.kocka-ask-worker</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/martinbaros/projects/urokova-kocka-mince/scripts/ask-worker.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/martinbaros/projects/urokova-kocka-mince</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/martinbaros/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>ASK_REMOTE</key><string>martin1:/home/bobek/projects/urokova-kocka-mince/data/ask,martin1:/home/bobek/projects/urokova-kocka-mince/data-martas/ask</string>
    <key>ASK_MODEL</key><string>sonnet</string>
    <key>HOME</key><string>/Users/martinbaros</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/martinbaros/Library/Logs/kocka-ask-worker.log</string>
  <key>StandardErrorPath</key><string>/Users/martinbaros/Library/Logs/kocka-ask-worker.log</string>
</dict></plist>
